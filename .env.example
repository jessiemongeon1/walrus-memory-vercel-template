# Walrus Memory credentials.
#
# Generate these once from the dashboard, then paste them here:
#   Mainnet  https://memory.walrus.xyz
#   Testnet  https://staging.memory.walrus.xyz
#
# Ed25519 delegate private key (hex, with or without 0x).
MEMWAL_PRIVATE_KEY=
# MemWalAccount object ID on Sui.
MEMWAL_ACCOUNT_ID=
# Relayer for your network. Must match the network the credentials came from.
#   Mainnet  https://relayer.memory.walrus.xyz
#   Testnet  https://relayer-staging.memory.walrus.xyz
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# Vercel AI Gateway. Deployments on Vercel authenticate automatically through
# OIDC, so this is only needed for local development.
#   https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=

# Optional: any model ID the AI Gateway serves.
# MODEL_ID=openai/gpt-4o-mini
